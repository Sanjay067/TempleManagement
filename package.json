{
  "name": "temple-management",
  "version": "1.0.0",
  "private": true,
  "description": "Temple Management System monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace=apps/admin run dev",
    "dev:admin-server": "npm --workspace=apps/admin-server run dev",
    "build:admin": "npm --workspace=apps/admin run build",
    "build": "npm --workspace=apps/admin run build",
    "seed:admin": "npm --workspace=apps/admin-server run seed"
  }
}
